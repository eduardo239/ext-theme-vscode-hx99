{
  "name": "neon-kiroshi",
  "displayName": "Neon Kiroshi",
  "description": "Temas escuros inspirados em Cyberpunk 2077: Neon Kiroshi (neon amarelo e ciano), Neon Kiroshi Mint (suave, verde-menta), Neon Kiroshi Cherry (suave, rosa-cereja) e Neon Kiroshi Noir (somente tons de cinza).",
  "version": "2.0.0",
  "publisher": "eduardo239",
  "license": "MIT",
  "icon": "icons/icon-marketplace.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardo239/ext-theme-vscode-hx99.git"
  },
  "bugs": {
    "url": "https://github.com/eduardo239/ext-theme-vscode-hx99/issues"
  },
  "homepage": "https://github.com/eduardo239/ext-theme-vscode-hx99#readme",
  "galleryBanner": {
    "color": "#0C0D14",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "cyberpunk",
    "cyberpunk 2077",
    "night city",
    "neon",
    "pink",
    "cherry",
    "monochrome",
    "grayscale"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "contributes": {
    "themes": [
      {
        "label": "Neon Kiroshi",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-kiroshi-color-theme.json"
      },
      {
        "label": "Neon Kiroshi Mint",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-kiroshi-mint-color-theme.json"
      },
      {
        "label": "Neon Kiroshi Cherry",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-kiroshi-cherry-color-theme.json"
      },
      {
        "label": "Neon Kiroshi Noir",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-kiroshi-noir-color-theme.json"
      }
    ]
  }
}
