{
  "name": "hx99-night-city",
  "displayName": "HX99 Night City",
  "description": "Temas escuros inspirados em Cyberpunk 2077: Night City (neon amarelo e ciano), Night City Mint (suave, verde-menta), Night City Cherry (suave, rosa-cereja) e Night City Noir (somente tons de cinza).",
  "version": "1.1.0",
  "publisher": "eduardo239",
  "license": "MIT",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardo239/ext-theme-vscode-hx99.git"
  },
  "bugs": {
    "url": "https://github.com/eduardo239/ext-theme-vscode-hx99/issues"
  },
  "homepage": "https://github.com/eduardo239/ext-theme-vscode-hx99#readme",
  "galleryBanner": {
    "color": "#0C0D14",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "cyberpunk",
    "cyberpunk 2077",
    "night city",
    "neon",
    "pink",
    "cherry",
    "monochrome",
    "grayscale"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "contributes": {
    "themes": [
      {
        "label": "HX99 Night City",
        "uiTheme": "vs-dark",
        "path": "./themes/hx99-night-city-color-theme.json"
      },
      {
        "label": "HX99 Night City Mint",
        "uiTheme": "vs-dark",
        "path": "./themes/hx99-night-city-mint-color-theme.json"
      },
      {
        "label": "HX99 Night City Cherry",
        "uiTheme": "vs-dark",
        "path": "./themes/hx99-night-city-cherry-color-theme.json"
      },
      {
        "label": "HX99 Night City Noir",
        "uiTheme": "vs-dark",
        "path": "./themes/hx99-night-city-noir-color-theme.json"
      }
    ]
  }
}
