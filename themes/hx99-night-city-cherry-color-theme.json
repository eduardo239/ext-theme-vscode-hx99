  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A6670",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#B4E0B0"
      }
    },
    {
      "name": "Escapes / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A3E0DC"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F2B07C"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F2B07C"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#EBA9D6"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#D9C9D0"
      }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A5BEE8"
      }
    },
    {
      "name": "Classes / tipos",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#A3E0DC"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F6EDF1"
      }
    },
    {
      "name": "Parâmetros",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D9B8F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#F2A6C0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D9C9D0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#F28FA3"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F0D99A"
      }
    },
    {
      "name": "Decorators / anotações",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#E2C57E"
      }
    },
    {
      "name": "Pontuação",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D9C9D0B0"
      }
    },
    {
      "name": "Namespaces / módulos",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#A3E0DC"
      }
    },
    {
      "name": "Shell: comandos",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell",
        "support.function.shell"
      ],
      "settings": {
        "foreground": "#B4E0B0"
      }
    },
    {
      "name": "Shell: variáveis",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#F0D99A"
      }
    },
    {
      "name": "CSS: seletores",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#F0D99A"
      }
    },
    {
      "name": "CSS: propriedades",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#F2A6C0"
      }
    },
    {
      "name": "CSS: unidades",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#F2A6C0"
      }
    },
    {
      "name": "JSON: chaves",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#F2A6C0"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#F2A6C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F0D99A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EBA9D6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#B4E0B0"
      }
    },
    {
      "name": "Markdown: links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F2A6C0"
      }
    },
    {
      "name": "Markdown: citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7A6670",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: listas",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#F2A6C0"
      }
    },
    {
      "name": "Diff: inserido",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#B4E0B0"
      }
    },
    {
      "name": "Diff: removido",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#F28FA3"
      }
    },
    {
      "name": "Diff: alterado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E2C57E"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F0607A"
      }
    }
  ],
  "semanticTokenColors": {
