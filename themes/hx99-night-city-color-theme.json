  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5F6B8A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#3DFFB0"
      }
    },
    {
      "name": "Escapes / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF9E00"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF2A6D"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#C8CCE0"
      }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "Classes / tipos",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#B47CFF"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F2F4FF"
      }
    },
    {
      "name": "Parâmetros",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FF7AC6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#FCEE0A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C8CCE0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#FF003C"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "name": "Decorators / anotações",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#FF9E00"
      }
    },
    {
      "name": "Pontuação",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C8CCE0B0"
      }
    },
    {
      "name": "Namespaces / módulos",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#B47CFF"
      }
    },
    {
      "name": "Shell: comandos",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell",
        "support.function.shell"
      ],
      "settings": {
        "foreground": "#00FF9F"
      }
    },
    {
      "name": "Shell: variáveis",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "name": "CSS: seletores",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "name": "CSS: propriedades",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "CSS: unidades",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "name": "JSON: chaves",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#FCEE0A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FCEE0A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FF2A6D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#3DFFB0"
      }
    },
    {
      "name": "Markdown: links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "Markdown: citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5F6B8A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: listas",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#FCEE0A"
      }
    },
    {
      "name": "Diff: inserido",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#00FF9F"
      }
    },
    {
      "name": "Diff: removido",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#FF3D5E"
      }
    },
    {
      "name": "Diff: alterado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FF9E00"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF003C"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#B47CFF",
    "type": "#B47CFF",
    "class": "#B47CFF",
    "interface": "#B47CFF",
    "enum": "#B47CFF",
    "enumMember": "#FCEE0A",
    "function": "#00F0FF",
    "method": "#00F0FF",
    "parameter": {
      "foreground": "#FF7AC6",
      "italic": true
    },
    "property": "#C8CCE0",
    "variable.readonly": "#FCEE0A",
    "variable.defaultLibrary": "#B47CFF",
    "decorator": "#FF9E00",
    "macro": "#FF9E00"
  }
}
