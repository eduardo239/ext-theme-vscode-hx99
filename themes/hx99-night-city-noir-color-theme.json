  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B6B6B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9E9E9E"
      }
    },
    {
      "name": "Escapes / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C4C4C4"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B0B0B0"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#CFCFCF"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#D0D0D0"
      }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "name": "Classes / tipos",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#C0C0C0"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F5F5F5"
      }
    },
    {
      "name": "Parâmetros",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#B8B8B8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#E6E6E6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D0D0D0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#E8E8E8"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A0A0A0"
      }
    },
    {
      "name": "Decorators / anotações",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#A6A6A6"
      }
    },
    {
      "name": "Pontuação",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D0D0D0B0"
      }
    },
    {
      "name": "Namespaces / módulos",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#C0C0C0"
      }
    },
    {
      "name": "Shell: comandos",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell",
        "support.function.shell"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Shell: variáveis",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "CSS: seletores",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "CSS: propriedades",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#E0E0E0"
      }
    },
    {
      "name": "CSS: unidades",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E6E6E6"
      }
    },
    {
      "name": "JSON: chaves",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#E0E0E0"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#E6E6E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D4D4D4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#A8A8A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#B8B8B8"
      }
    },
    {
      "name": "Markdown: links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#E0E0E0"
      }
    },
    {
      "name": "Markdown: citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6B6B6B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: listas",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#E6E6E6"
      }
    },
    {
      "name": "Diff: inserido",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Diff: removido",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },
    {
      "name": "Diff: alterado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#A6A6A6"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    }
  ],
  "semanticTokenColors": {
