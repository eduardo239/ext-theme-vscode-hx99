  "tokenColors": [
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#67766C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#EBDD91"
      }
    },
    {
      "name": "Escapes / regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9BE3D8"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E8A87C"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D6A6CE"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#C9D6CC"
      }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "Classes / tipos",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#9BE3D8"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#EAF3EC"
      }
    },
    {
      "name": "Parâmetros",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#96BEDC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#9CD0A6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C9D6CC"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#EC8B92"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EBDD91"
      }
    },
    {
      "name": "Decorators / anotações",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#E0C47A"
      }
    },
    {
      "name": "Pontuação",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C9D6CCB0"
      }
    },
    {
      "name": "Namespaces / módulos",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#9BE3D8"
      }
    },
    {
      "name": "Shell: comandos",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell",
        "support.function.shell"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "Shell: variáveis",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#EBDD91"
      }
    },
    {
      "name": "CSS: seletores",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#EBDD91"
      }
    },
    {
      "name": "CSS: propriedades",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "CSS: unidades",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#9CD0A6"
      }
    },
    {
      "name": "JSON: chaves",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#9CD0A6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#EBDD91",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: itálico",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D6A6CE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "Markdown: links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "Markdown: citação",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#67766C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: listas",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#9CD0A6"
      }
    },
    {
      "name": "Diff: inserido",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#A8E0B5"
      }
    },
    {
      "name": "Diff: removido",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#EC8B92"
      }
    },
    {
      "name": "Diff: alterado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E0C47A"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E8757D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9BE3D8",
    "type": "#9BE3D8",
    "class": "#9BE3D8",
    "interface": "#9BE3D8",
    "enum": "#9BE3D8",
    "enumMember": "#E8A87C",
    "function": "#A8E0B5",
    "method": "#A8E0B5",
    "parameter": {
      "foreground": "#96BEDC",
      "italic": true
